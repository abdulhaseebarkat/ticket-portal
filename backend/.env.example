DB_HOST=localhost
DB_PORT=5432
DB_NAME=plant_it_support
DB_USERNAME=plantit
DB_PASSWORD=plantit

# Signs portal login sessions - MUST be a long random value for any real
# deployment (e.g. `openssl rand -base64 48`). Anyone with this can forge a
# valid login.
APP_AUTH_TOKEN_SECRET=change-me
APP_AUTH_TOKEN_EXPIRATION_MINUTES=240

# Only used once, to create the single portal login account the first time
# the app starts against an empty database. Change the password afterward
# from inside the app (Sidebar -> Change Password), not by editing this.
APP_AUTH_SEED_EMAIL=it.support@slmtires.com
APP_AUTH_SEED_PASSWORD=slmtires@123

# WhatsApp group bridge (see whatsapp-bridge/) - a random long string, must
# match BRIDGE_SHARED_SECRET in whatsapp-bridge/.env
WHATSAPP_BRIDGE_SECRET=change-me-too
WHATSAPP_MEDIA_PATH=./data/whatsapp-media
