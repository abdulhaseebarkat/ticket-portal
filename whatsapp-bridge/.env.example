BACKEND_URL=http://localhost:8080
BRIDGE_SHARED_SECRET=change-me-too
AUTH_DIR=./auth
LOG_LEVEL=info

# How far back to backfill a group's chat history right after a fresh QR
# link (WhatsApp only offers history once, at link time - not on demand
# later). Keep this short: older messages are more likely already resolved
# in person, and would misrepresent today's dashboard as still-open issues.
WHATSAPP_HISTORY_BACKFILL_HOURS=48
