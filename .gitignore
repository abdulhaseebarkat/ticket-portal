# Secrets - never commit actual .env files, only .env.example templates
.env
.env.*
!.env.example

# WhatsApp bridge's live session - these are the actual cryptographic keys
# for the linked WhatsApp account. Committing this would let anyone with
# repo access impersonate that WhatsApp session.
whatsapp-bridge/auth/

